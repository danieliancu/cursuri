# Copiază acest fișier în .env și completează cheia furnizorului ales.

# anthropic (Claude) sau openai
PYTUTOR_PROVIDER=anthropic

# docker (container izolat per elev) sau local
PYTUTOR_SANDBOX=docker
# 1 = elevii își fac singuri cont; 0 = doar adminul creează conturi
PYTUTOR_ALLOW_SIGNUP=1

ANTHROPIC_API_KEY=
# PYTUTOR_MODEL=claude-opus-5-5
# PYTUTOR_EFFORT=medium        # low | medium | high
# Modelul mic: „Rulează și verifică”, formularea verdictelor, rezumate
# PYTUTOR_CHECK_MODEL=claude-haiku-5-5

OPENAI_API_KEY=
PYTUTOR_OPENAI_MODEL=gpt-4.1
# PYTUTOR_OPENAI_CHECK_MODEL=gpt-4.1-mini
